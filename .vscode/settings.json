{
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "json.schemas": [
    {
      "fileMatch": ["**/_meta.json"],
      "url": "https://unpkg.com/@rspress/core@2.0.0-rc.2/meta-json-schema.json"
    },
    {
      "fileMatch": ["**/_nav.json"],
      "url": "https://unpkg.com/@rspress/core@2.0.0-rc.2/nav-json-schema.json"
    }
  ]
}
