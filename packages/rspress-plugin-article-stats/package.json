{
  "name": "@sonder/rspress-plugin-article-stats",
  "version": "0.1.0",
  "description": "Rspress plugin to display article reading time and word count",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
