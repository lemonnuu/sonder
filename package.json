{
  "name": "sonder-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nx run-many --target=dev",
    "dev:blog": "nx run blog:dev",
    "frontmatter": "npx tsx scripts/auto-frontmatter.ts",
    "frontmatter:watch": "npx tsx scripts/auto-frontmatter.ts --watch",
    "build": "nx run-many --target=build",
    "build:blog": "nx run blog:build",
    "build:plugins": "nx run-many --target=build --projects=rspress-plugin-devkit,rspress-plugin-article-stats",
    "preview:blog": "nx run blog:preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\"",
    "clean": "nx run-many --target=clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nx/js": "^21.3.3",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "chokidar": "^4.0.3",
    "cspell-ban-words": "^0.0.4",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "nx": "^21.3.3",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.20",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
